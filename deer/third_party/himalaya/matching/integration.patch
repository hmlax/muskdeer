+    pub(crate) async fn maker_place(
+        &self,
+        req: PlaceOrderRequest,
+        authority: crate::maker_fence::Authorization,
+    ) -> Result<PlaceOrderResponse, Status> {
+        if nats_subjects::is_shutting_down() {
+            return Err(Status::unavailable("service is shutting down"));
+        }
+        self.validate_market(&req.symbol)
+            .map_err(crate::place_pipeline::not_admitted)?;
+        let mut result = if let Some(queue) = &self.place_queue {
+            queue.submit_authorized(req, Some(authority)).await
+        } else {
+            let engine = self.engine.clone();
+            nats_subjects::run_blocking(move || {
+                crate::place_pipeline::execute_place_authorized(engine, req, Some(authority))
+            })
+            .await
+            .map_err(|_| Status::internal("maker execution owner failed"))?
+        }?;
+        result.has_more_deals = result.deals.len() > 128;
+        result.deals.truncate(128);
+        Ok(result)
+    }
+
+    pub(crate) async fn system_reduce(
+        &self,
