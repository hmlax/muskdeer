+    pub fn enable_development_maker_authority(&mut self) -> std::io::Result<()> {
+        match std::env::var("HIMALAYA_MAKER_DEVELOPMENT_TEST_FUNDS") {
+            Err(std::env::VarError::NotPresent) => return Ok(()),
+            Ok(value) if value == "false" => return Ok(()),
+            Ok(value) if value == "true" => {}
+            _ => return Err(std::io::Error::other("invalid maker development profile")),
+        }
+        let registry = crate::maker_fence::Registry::from_env()?;
+        if !registry.durable() {
+            return Err(std::io::Error::other(
+                "maker authority requires a persistent outbox directory",
+            ));
+        }
+        self.maker_authority = Some(Arc::new(registry));
+        Ok(())
