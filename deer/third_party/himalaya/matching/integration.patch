+        authority: crate::maker_service::SystemAuthorization,
+    ) -> Result<PlaceOrderResponse, Status> {
+        if nats_subjects::is_shutting_down() {
+            return Err(Status::unavailable("service is shutting down"));
+        }
+        self.validate_market(&req.symbol)
+            .map_err(crate::place_pipeline::not_admitted)?;
+        let mut response = if let Some(queue) = &self.place_queue {
+            queue.submit_system(req, authority).await
+        } else {
+            let engine = self.engine.clone();
+            nats_subjects::run_blocking(move || {
+                crate::place_pipeline::execute_place_guarded(engine, req, None, Some(authority))
+            })
+            .await
+            .map_err(|_| Status::internal("system reduction owner failed"))?
+        }?;
+        response.has_more_deals = response.deals.len() > 128;
+        response.deals.truncate(128);
+        Ok(response)
