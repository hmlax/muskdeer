+    pub async fn connect_with_authority(
+        client: MatchingEngineClient<tonic::transport::Channel>,
+        channel: tonic::transport::Channel,
+    ) -> Result<Self, Status> {
+        let mut stream = Self::connect(client).await?;
+        stream.authority = Some(
+            crate::maker_matching_proto::matching_authority_client::MatchingAuthorityClient::new(
+                channel,
+            ),
+        );
+        Ok(stream)
+    }
+
+    pub(crate) fn authority_client(
+        &self,
+    ) -> Option<
+        crate::maker_matching_proto::matching_authority_client::MatchingAuthorityClient<
+            tonic::transport::Channel,
+        >,
+    > {
+        self.authority.clone()
+    }
+
+    pub(crate) async fn risk_reduce_one(
+        &self,
+        order: PlaceOrderRequest,
+        episode: &str,
+    ) -> Result<PlaceOrderResponse, Status> {
+        let mut client = self.authority_client().ok_or_else(|| not_sent())?;
+        let token = std::env::var("ADMIN_AUTH_TOKEN").map_err(|_| not_sent())?;
+        let id = order.order_id;
+        let symbol = order.symbol.clone();
+        let mut request = app_config::auth::request_with_token(
+            crate::maker_matching_proto::SystemReduceRequest {
+                order: Some(order),
+                episode_id: episode.into(),
+                maximum_queue_age_ms: 2_000,
+            },
+            &token,
+        );
+        request.set_timeout(std::time::Duration::from_secs(2));
+        let response = client.system_reduce(request).await?.into_inner();
+        if response.order_id != id {
+            return Err(Status::data_loss(
+                "native reduction response identity mismatch",
+            ));
+        }
+        if response.has_more_deals {
+            return self.outcome(id, &symbol).await?.result.ok_or_else(|| {
+                Status::unavailable("complete native reduction outcome unavailable")
+            });
+        }
+        Ok(response)
+    }
+
